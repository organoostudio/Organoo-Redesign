---
import BaseLayout from '../../layouts/BaseLayout.astro';

const prototypes = [
  {
    name: 'Motion',
    href: '/previews/motion/',
    tag: 'Current direction',
    desc: 'Option 1 with the enhanced motion layer — scroll-scrubbed hero video, gradient-blur nav and the curtain footer wordmark. This is what the live site at / is built from.',
  },
  {
    name: 'Home',
    href: '/previews/home/',
    tag: 'Hero study',
    desc: 'The home page on its own, focused on the scroll-scrubbed hero video.',
  },
  {
    name: 'Website',
    href: '/previews/website/',
    tag: 'Option 1 · baseline',
    desc: 'The original option 1 across all pages (hash-routed), before the motion layer.',
  },
  {
    name: 'Growth Lab',
    href: '/previews/growth-lab/',
    tag: 'Option 2 · reference',
    desc: 'An alternate palette and heavier scroll effects, kept for reference.',
  },
];
---
<BaseLayout
  title="Prototypes — Organoo Studio Redesign"
  description="Live prototypes for the Organoo Studio website redesign."
  path="/previews/"
>
  <style is:global>
    :root {
      color-scheme: dark;
      --bg: #0a0a0a; --bg-2: #050505; --text: #fff; --muted: #a3aaa6;
      --line: rgba(255, 255, 255, 0.12); --accent: #2aa36b;
      --font: 'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif;
      --serif: 'Instrument Serif', Georgia, serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--font); -webkit-font-smoothing: antialiased; }
    .wrap { max-width: 1040px; margin: 0 auto; padding: clamp(48px, 9vw, 110px) 20px 80px; }
    .eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
    .eyebrow::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
    h1 { font-size: clamp(34px, 6vw, 62px); line-height: 1.02; letter-spacing: -0.04em; margin: 16px 0 10px; }
    h1 em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
    .lede { color: var(--muted); max-width: 60ch; font-size: 17px; line-height: 1.6; }
    .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 44px; }
    @media (max-width: 680px) { .grid { grid-template-columns: 1fr; } }
    .card { display: block; border: 1px solid var(--line); border-radius: 16px; padding: 26px; background: var(--bg-2); transition: border-color 0.25s, transform 0.25s; }
    .card:hover { border-color: var(--accent); transform: translateY(-3px); }
    .card .tag { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
    .card h2 { margin: 10px 0 8px; font-size: 26px; letter-spacing: -0.03em; }
    .card p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.55; }
    .card .go { margin-top: 16px; font-size: 14px; font-weight: 600; color: var(--text); }
    .card:hover .go { color: var(--accent); }
    footer { margin-top: 56px; color: #6e7571; font-size: 13px; }
    a { color: inherit; text-decoration: none; }
  </style>
  <main class="wrap">
    <span class="eyebrow">Organoo Studio · Redesign</span>
    <h1>Prototype <em>gallery</em></h1>
    <p class="lede">
      Four working prototypes from the redesign. The live site at the root is built from the
      Motion direction; the others are kept here for comparison.
    </p>
    <div class="grid">
      {prototypes.map((p) => (
        <a class="card" href={p.href}>
          <span class="tag">{p.tag}</span>
          <h2>{p.name}</h2>
          <p>{p.desc}</p>
          <div class="go">Open prototype →</div>
        </a>
      ))}
    </div>
    <footer>← <a href="/">Back to the live site</a></footer>
  </main>
</BaseLayout>
